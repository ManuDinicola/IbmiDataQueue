{
  "name": "IbmiDataQueue (IBM i ODBC)",
  "build": { "dockerfile": "Dockerfile" },
  "remoteEnv": {
    "IBMI_HOST": "pub400.com",
    "IBMI_USER": "IDINICOLA",
