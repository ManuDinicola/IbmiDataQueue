    "IBMI_ODBC_DRIVER": "IBM i Access ODBC Driver",
    "IBMI_PASSWORD": "${localEnv:IBMI_PASSWORD}",
    "DqTfm": "net10.0"
  },
  "customizations": {
    "vscode": { "extensions": ["ms-dotnettools.csdevkit", "ms-dotnettools.csharp"] }
  }
}
