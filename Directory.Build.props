<Project>
  <PropertyGroup>
    <!-- .NET 11 par défaut. Surchargeable (propagé aux références) : dotnet build -p:DqTfm=net10.0 -->
    <DqTfm Condition="'$(DqTfm)' == ''">net11.0</DqTfm>
    <TargetFramework>$(DqTfm)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
